# Copy to .env and fill in. On a host (Render, Railway, ...) set these as environment variables instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/virktech?sslmode=verify-full
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production it must be 32+ characters; changing it logs everyone out.
JWT_SECRET=
# Only needed when the website is served from a different address than the API (e.g. local dev).
CLIENT_URL=http://localhost:5173
PORT=5000
# Production only: set NODE_ENV=production (secure cookies, strict checks) and TRUST_PROXY=1 behind one reverse proxy.
# NODE_ENV=production
# TRUST_PROXY=1
# DB_POOL_MAX=10
